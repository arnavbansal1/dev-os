# ============================================================================
# ContractIQ — environment variables
# Copy to .env.local and fill in values. Never commit .env.local.
# Values are intentionally empty here (this is .env.example).
# ============================================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=            # Supabase project URL — Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase anon/public key — Settings > API > Project API keys > anon
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY — Settings > API > service_role. Bypasses RLS. Never expose to the browser.

# ---- OpenAI ----
OPENAI_API_KEY=                     # SERVER ONLY — platform.openai.com > API keys
OPENAI_MODEL=gpt-4o                 # Primary model for extraction + chat (default: gpt-4o)
OPENAI_MAX_OUTPUT_TOKENS_EXTRACT=2000   # Cap for extraction responses (engineering-doc §8)
OPENAI_MAX_OUTPUT_TOKENS_CHAT=1000      # Cap for chat responses
OPENAI_TEMPERATURE_EXTRACT=0.1      # Deterministic extraction
OPENAI_TEMPERATURE_CHAT=0.4         # Slightly warmer chat

# ---- Anthropic (optional fallback — documented in engineering-doc §8, not wired at MVP) ----
ANTHROPIC_API_KEY=                  # SERVER ONLY — optional cost/outage fallback; leave blank at MVP
ANTHROPIC_MODEL=                    # e.g. claude-sonnet-5 (leave blank unless fallback enabled)

# ---- App limits (align with engineering-doc §5 constraints) ----
MAX_UPLOAD_BYTES=10485760           # 10 MB PDF upload cap
MAX_PDF_PAGES=20                    # Reject contracts over 20 pages
MAX_CONTRACT_TOKENS=15000           # Reject contracts over 15,000 tokens
MAX_CUSTOM_TERMS=5                  # Max user-added custom key terms per analysis
MIN_EXTRACTED_WORDS=100             # Below this => treat as scanned/image PDF and reject
SIGNED_URL_TTL_SECONDS=3600         # 1-hour signed URL for the PDF viewer
MAX_MESSAGE_LENGTH=2000             # Max chat message length in characters
MAX_CHAT_HISTORY=100                # Max prior chat turns loaded per request (token/cost ceiling)

# ---- Rate limiting (durable, Supabase-backed — see supabase/rls-policies.sql) ----
RATE_LIMIT_PROCESS_PER_HOUR=20      # Max /process calls per user per hour
RATE_LIMIT_CHAT_PER_MINUTE=10       # Max /chat calls per user per minute
RATE_LIMIT_UPLOAD_PER_DAY=20        # Max uploads per user per day
# Login is limited to 10 attempts/minute per client IP (hard-coded in lib/security/rateLimiter.ts)

# ---- Runtime ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # Base URL (used for auth email redirects)
